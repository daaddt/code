{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "description": "内部测试 APK，可直接装到安卓手机，无需上架商店",
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal"
    },
    "production": {
      "description": "正式发布版 APK",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
